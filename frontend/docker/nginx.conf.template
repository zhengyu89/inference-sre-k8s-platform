# Rendered to /etc/nginx/conf.d/default.conf at container start by the
# official nginx image's envsubst-on-templates entrypoint. BACKEND_HOST /
# BACKEND_PORT are the only substituted vars (see NGINX_ENVSUBST_FILTER in
# the Dockerfile) so this points at whatever backend Service the frontend
# container is deployed alongside (docker-compose service name, or the
# Kubernetes Service name/port).
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Container-level liveness check, independent of the backend.
    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Same-origin API access — the frontend always calls /api/..., so no
    # backend URL needs to be baked into the built JS per environment.
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri /index.html;
    }
}
